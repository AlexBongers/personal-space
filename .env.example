# Google Cloud OAuth 2.0 web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-tasks/callback

# Base64url-encoded 32-byte AES-GCM key used to encrypt the Google refresh token in D1.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Bearer token for the local Parro watcher. Keep this in the Site runtime and on the watcher host only.
PARRO_SYNC_TOKEN=

# Optional local development or Hermes/QNAP destination for scripts/parro_watcher.py.
PARRO_SYNC_URL=http://localhost:3000/api/parro/sync
