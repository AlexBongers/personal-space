# Google Cloud OAuth 2.0 web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-tasks/callback

# Base64url-encoded 32-byte AES-GCM key used to encrypt the Google refresh token in D1.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional separate base64url-encoded 32-byte AES-GCM key for direct Parro sync.
# Falls back to GOOGLE_TOKEN_ENCRYPTION_KEY with Parro-specific authenticated context.
PARRO_TOKEN_ENCRYPTION_KEY=

# Legacy importer only; direct Parro sync does not need these variables.
PARRO_SYNC_TOKEN=
PARRO_SYNC_URL=http://localhost:3000/api/parro/sync
